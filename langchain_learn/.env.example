# ============================================
# LangChain.js Examples - Environment Variables
# ============================================
# Copy this file to .env and fill in your API keys
# cp .env.example .env

# ============================================
# Core LLM Providers
# ============================================

# OpenAI (Required for most examples)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google (Gemini, Vertex AI)
GOOGLE_API_KEY=your_google_api_key_here

# Cohere
COHERE_API_KEY=your_cohere_api_key_here

# Mistral AI
MISTRAL_API_KEY=your_mistral_api_key_here

# ============================================
# Azure OpenAI
# ============================================
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_API_INSTANCE_NAME=your_instance_name
AZURE_OPENAI_API_DEPLOYMENT_NAME=your_deployment_name
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_BASE_PATH=https://your-resource.openai.azure.com

# Azure Container App (Dynamic Sessions)
AZURE_CONTAINER_APP_SESSION_POOL_MANAGEMENT_ENDPOINT=your_endpoint_here

# ============================================
# Other LLM Providers
# ============================================

# AI21
AI21_API_KEY=your_ai21_api_key_here

# Aleph Alpha
ALEPH_ALPHA_API_KEY=your_aleph_alpha_api_key_here

# DeepInfra
DEEPINFRA_API_TOKEN=your_deepinfra_api_token_here

# Fireworks AI
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Friendli AI
FRIENDLI_TOKEN=your_friendli_token_here
FRIENDLI_TEAM=your_friendli_team_here

# Gradient AI
GRADIENT_ADAPTER_ID=your_gradient_adapter_id_here

# Writer
WRITER_API_KEY=your_writer_api_key_here
WRITER_ORG_ID=your_writer_org_id_here

# ============================================
# Vector Stores & Databases
# ============================================

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=your_pinecone_index_name

# Weaviate
WEAVIATE_SCHEME=https
WEAVIATE_HOST=your_weaviate_host_here
WEAVIATE_API_KEY=your_weaviate_api_key_here

# Vectara
VECTARA_CUSTOMER_ID=your_vectara_customer_id
VECTARA_CORPUS_ID=your_vectara_corpus_id
VECTARA_API_KEY=your_vectara_api_key_here

# Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_PRIVATE_KEY=your_supabase_private_key_here

# Metal
METAL_API_KEY=your_metal_api_key_here
METAL_CLIENT_ID=your_metal_client_id_here
METAL_INDEX_ID=your_metal_index_id_here

# Chaindesk
CHAINDESK_API_KEY=your_chaindesk_api_key_here

# ============================================
# Caching & Storage
# ============================================

# Upstash Redis
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Vercel KV
VERCEL_KV_API_URL=your_vercel_kv_api_url
VERCEL_KV_API_TOKEN=your_vercel_kv_api_token

# Momento (for caching)
# Get credentials from: https://console.gomomento.com/
MOMENTO_API_KEY=your_momento_api_key_here

# Cloudflare KV
# Set via Cloudflare Workers environment variables

# ============================================
# Search & Retrieval APIs
# ============================================

# Tavily Search
TAVILY_API_KEY=your_tavily_api_key_here

# Exa (formerly Metaphor)
EXASEARCH_API_KEY=your_exa_search_api_key_here

# SearchAPI
SEARCHAPI_API_KEY=your_searchapi_api_key_here

# SerpAPI (for Google search)
SERPAPI_API_KEY=your_serpapi_api_key_here

# Serper (Google search alternative)
SERPER_API_KEY=your_serper_api_key_here

# Bing Search
BING_SEARCH_API_KEY=your_bing_search_api_key_here

# ============================================
# Google Services
# ============================================

# Google Calendar
GOOGLE_CALENDAR_CLIENT_EMAIL=your_service_account_email
GOOGLE_CALENDAR_PRIVATE_KEY=your_service_account_private_key
GOOGLE_CALENDAR_CALENDAR_ID=your_calendar_id

# Gmail
GMAIL_CLIENT_EMAIL=your_service_account_email
GMAIL_PRIVATE_KEY=your_service_account_private_key

# ============================================
# Embeddings Providers
# ============================================

# Jina AI
JINA_API_TOKEN=your_jina_api_token_here

# ============================================
# Monitoring & Observability
# ============================================

# LangSmith (Tracing & Monitoring)
# Get your API key from: https://smith.langchain.com/
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=langchain-learn
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_HANDLER=langchain

# Lunary (Alternative monitoring)
# LUNARY_API_KEY=your_lunary_api_key_here
# LUNARY_APP_ID=your_lunary_app_id_here

# ============================================
# Security & Guardrails
# ============================================

# Layerup Security
LAYERUP_API_KEY=your_layerup_api_key_here

# ============================================
# Tools & Integrations
# ============================================

# Connery (Workflow automation)
CONNERY_RUNNER_URL=your_connery_runner_url
CONNERY_RUNNER_API_KEY=your_connery_runner_api_key

# ============================================
# Memory & State Management
# ============================================

# Zep (Long-term memory)
ZEP_URL=http://localhost:8000
ZEP_API_KEY=your_zep_api_key_here

# ============================================
# Database Connections
# ============================================

# PostgreSQL (for document loaders, etc.)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DATABASE=your_database_name
POSTGRES_CONNECTION_STRING=postgresql://user:password@host:port/database

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=your_database_name

# Redis (local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ============================================
# Cloud Storage
# ============================================

# AWS (for S3, Bedrock, etc.)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# Google Cloud Storage
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name
AZURE_STORAGE_ACCOUNT_KEY=your_storage_account_key
AZURE_STORAGE_CONNECTION_STRING=your_connection_string

# ============================================
# Notes
# ============================================
# - Not all variables are required for all examples
# - Only set the variables you need for the examples you're running
# - Some providers offer free tiers for testing
# - Keep your .env file secure and never commit it to version control
# - For production, use a secrets management service
